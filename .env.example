# Copy to .env. Generate THREE DISTINCT random secrets — do not reuse one value.
# (e.g. `openssl rand -hex 32` each). Services fail-closed if their token is unset.
#   RUNNER_TOKEN   — n8n/router -> the runners   (header: x-runner-token)
#   ROUTER_TOKEN   — n8n -> the router           (header: x-router-token)
#   SCRUBBER_TOKEN — n8n -> the scrubber          (header: x-scrubber-token)
# In the workflow HTTP nodes, send the token that matches the TARGET:
#   /route -> ROUTER_TOKEN; /run,/fanout -> RUNNER_TOKEN; scrubber/* -> SCRUBBER_TOKEN.
RUNNER_TOKEN=change-me-runner-secret
ROUTER_TOKEN=change-me-router-secret
SCRUBBER_TOKEN=change-me-scrubber-secret
LANES_TOKEN=change-me-lanes-secret

# --- Notifications: pick ONE channel, set its URL (see n8n-workflows/README) ---
NOTIFY_CHANNEL=webhook          # slack | teams | webhook
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL=

# --- Google Drive lanes (drive-sync, deliverables) ---
# The folder id from the Drive URL: .../folders/<THIS PART>
# The lanes refuse to run while this is empty, rather than query a bogus id.
DRIVE_FOLDER_ID=

# --- Loop budget: default stop condition for every /run (bounds token spend) ---
DEFAULT_MAX_TURNS=40

# --- Parallel fan-out: how many worktree agents run at once (AG-2) ---
FANOUT_CONCURRENCY=4

# (ROUTER_TOKEN / SCRUBBER_TOKEN are defined at the top — distinct required secrets.)

# --- Local-dev escape hatch: set to 1 to let services boot without tokens.
#     NEVER use with real data — every endpoint becomes unauthenticated. ---
# ALLOW_NO_AUTH=1

# --- Gemini provider flag: swap to Antigravity (or another headless CLI) by
#     changing the binary/flags here — no code edits. Confirm the current CLI
#     name/flags on your machine first (Gemini CLI free tier was migrating to
#     Antigravity CLI ~June 2026). ---
AGENT_BIN=gemini
PROMPT_FLAG=-p
GEMINI_EXTRA_ARGS=--yolo --output-format json

# --- Optional: let Claude create/update/run workflows in your n8n instance ---
# Leave these blank to run n8n-mcp in docs + validation-only mode (Claude can
# still read real node schemas and validate — it just can't write to n8n).
# Create the key in n8n: Settings -> n8n API -> Create an API key.
# Point at the internal service name (both containers share the docker network).
N8N_API_URL=
# N8N_API_URL=http://n8n:5678/api/v1
N8N_API_KEY=

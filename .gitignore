# Secrets — never commit
.env

# Python bytecode cache
__pycache__/
*.pyc

# PII token vault — the whole point is that this never leaves the machine
vault/

# Audit ledger — runtime compliance record; retain on the deploy volume, not in source.
# This also covers audit/deletions/ — the deletion certificates from
# scripts/offboard_scope.py are compliance EVIDENCE kept on the deploy volume
# (ship to WORM/append-only storage), never committed to the framework repo.
audit/

# Kill switch runtime state — the operator halt flag lives on the deploy volume,
# not in source. Ignore everything under control/ EXCEPT the committed example.
control/*
!control/halt.example.json

# Eval / improvement-loop data — regression datasets, captured traces, and the
# feedback inbox hold TOKENIZED tenant content (governed observability: per-scope,
# PII-tokenized, retention-bound, local). Keep them on the deploy volume, NOT in
# source — EXCEPT the committed starter suite (the same pattern as control/ above).
eval/datasets/**
!eval/datasets/starter/
!eval/datasets/starter/**
eval/traces/
eval/inbox/

# Status page — generated by scripts/gen_status.py from the LIVE stack. It embeds
# real scope names, project paths and session counts, so it is deploy-local
# evidence, not source. The generator is committed; its output never is.
status.html

# Raw research fetches — somebody else's pages cached locally as EVIDENCE for a
# citation, not source. Cite the URL, the date and the quoted line in the doc;
# this directory is what lets you re-check it. Written by scripts/fetch_source.py.
research/raw/

# Eval results ledger — one append per `eval_run --record`, read by
# eval_history.py. Local measurement data, and it carries SCOPE NAMES per case,
# which is the same reason the real scope tree is not tracked here.
eval/results.jsonl

# The point of ./workspace is to Git your workflow JSON + CLAUDE.md,
# so it is intentionally NOT ignored — but runtime work products are:
# engagement/tenant content stays out of the framework repo.
workspace/.fanout/
workspace/scopes/**/ingest/
workspace/scopes/**/deliverables/

# REAL scope trees are not tracked. `workspace/` ships in the public snapshot
# (it is not in .publish-exclude), so a context file under a real scope publishes
# that scope's name and the shape of the tree — the same leak scope_source.py
# routes `scopes.json` around, arriving by a path nothing was watching. The real
# tree's directories are empty until someone adds a CLAUDE.md, so this stayed
# invisible while it was only directories.
#
# ALLOWLIST, not a denylist: name the sample tree that may be tracked rather than
# listing real scopes to exclude. Listing them would put the real names in this
# file, which is itself tracked and published.
workspace/scopes/*
!workspace/scopes/enterprise/

# Local deployment state: what scripts/sync_workspace.py last copied out of the
# overlay, so it can tell its own output from a local edit. Per-machine, and it
# describes the real tree, so it is not tracked. Kept OUT of workspace/ because
# that directory is mounted into the runners — bookkeeping there is something
# every agent sees in `ls`.
.aicp/

# --- PII controls (ai-standards) ---
# Real personal data lives OUTSIDE the repo. These paths are conventional
# homes for it; the pre-commit hook is what actually enforces the rule.
*.local.*
*.private.*
.local/
data/private/
data/raw/
secrets/
.pii-vault/
.env
.env.*
!.env.example
# --- end PII controls ---

# --- Brand / private instance overlay (public-hygiene) ---
# Real identity lives in ../brightside-instance; this engine ships neutral.
context/brand.md
context/brand-tokens.css
!context/brand.example.md
!context/brand-tokens.example.css
marketing/
context/hygiene.json
!context/hygiene.example.json
# Operator guardrail patterns: the private tripwire set. The .example is the
# committed neutral one; the live file must never reach this public repo.
context/guardrail-patterns.json
!context/guardrail-patterns.example.json
# --- end brand ---

# ask-human answer channel — runtime handshake state, never source.
asks/

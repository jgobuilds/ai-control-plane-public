          }
        ]
      ]
    },
    "Approved?": {
      "main": [
        [
          {
            "node": "Commit promotion",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Rejected summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Commit promotion": {
      "main": [
